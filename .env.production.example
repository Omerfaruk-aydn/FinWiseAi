# =============================================================
# FinWise AI - Production Environment Example
# =============================================================
# Bu dosyayı sunucuda .env.production veya .env olarak kopyalayın.
# Gerçek şifreleri, API key'leri ve SMTP bilgilerini GitHub'a göndermeyin.
# =============================================================

# -------------------------------------------------------------
# App
# -------------------------------------------------------------
NODE_ENV="production"
NEXT_PUBLIC_APP_NAME="FinWise AI"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# -------------------------------------------------------------
# Database - PostgreSQL
# -------------------------------------------------------------
DATABASE_URL="postgresql://finwise_user:strong_password@postgres:5432/finwise_ai"

# -------------------------------------------------------------
# Auth.js / NextAuth
# -------------------------------------------------------------
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret-minimum-32-chars"
AUTH_TRUST_HOST="true"

# -------------------------------------------------------------
# Google Gemini
# -------------------------------------------------------------
GEMINI_API_KEY="replace-with-your-gemini-api-key"
AI_MODEL="gemini-2.5-flash"
AI_TEMPERATURE="0.3"
AI_MAX_TOKENS="3072"

# -------------------------------------------------------------
# Email
# provider: smtp veya resend
# -------------------------------------------------------------
EMAIL_PROVIDER="smtp"

# SMTP örneği
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="mail@your-domain.com"
SMTP_PASS="replace-with-smtp-password"
SMTP_TIMEOUT_MS="8000"

MAIL_FROM_EMAIL="mail@your-domain.com"
MAIL_FROM_NAME="FinWise AI"

# Resend kullanacaksanız EMAIL_PROVIDER="resend" yapıp bu alanı doldurun.
RESEND_API_KEY=""

# -------------------------------------------------------------
# PDF Reports
# -------------------------------------------------------------
PDF_STORAGE_PATH="./public/reports"

# -------------------------------------------------------------
# Admin / System
# -------------------------------------------------------------
SYSTEM_AUDIT_ADMIN_ID="system"
