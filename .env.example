# =============================================================
# FinWise AI - Ortam Değişkenleri
# =============================================================
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun:
# cp .env.example .env.local
# =============================================================

# -------------------------------------------------------------
# Veritabanı (PostgreSQL 15+)
# -------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/finwise_ai"

# -------------------------------------------------------------
# Auth.js (NextAuth v5)
# Minimum 32 karakter rastgele string:
# openssl rand -base64 32
# -------------------------------------------------------------
NEXTAUTH_SECRET="your-secret-here-min-32-chars-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# -------------------------------------------------------------
# AI Provider - Google Gemini
# https://aistudio.google.com/app/apikey adresinden alın
# -------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
AI_MODEL="gemini-2.5-flash-lite"
AI_TEMPERATURE="0.3"
AI_MAX_TOKENS="2048"

# -------------------------------------------------------------
# Uygulama
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="FinWise AI"

# -------------------------------------------------------------
# PDF Raporlar
# -------------------------------------------------------------
PDF_STORAGE_PATH="./public/reports"
